# Site-specific values for the fleet-deploy scripts.
#
# Copy to .env (gitignored) and fill in for your site. Every script in this
# directory sources it, so this is the only place a host name, IP or path is
# hard-coded. Values shown are the ones the reagent-fleet deployment uses.

# ── Where things live ────────────────────────────────────────────────
# Directory holding the server/runner/xzar configs, keys, tokens and helpers.
FLEET_DIR=/var/lib/reagent/fleet

# Checkout holding the built binaries. The server binary is read from the
# dx output dir; the runner and daemon from target/release.
CHECKOUT=/var/lib/reagent/worktrees/mac-mgmt/mac-mgmt-node-setup

# ── Management server ────────────────────────────────────────────────
# Port the mac-mgmt server API listens on, and the URL it advertises to
# daemons (must be reachable from the fleet's instances).
SERVER_PORT=7378
SERVER_EXTERNAL_URL=http://[2a01:4f8:c012:2caf:3010::1]:7378
RUNNER_PORT=9400
# Prefix for the fleet's instance names. Must not collide with any other Incus
# project sharing the bridge (see templates/runner-config.toml).
INSTANCE_PREFIX=reagent-

# ── Local xzar binary cache ──────────────────────────────────────────
XZAR_PORT=17788
XZAR_URL=http://127.0.0.1:17788
# The xzar-server binary to run.
XZAR_SERVER_BIN=/nix/store/2faqldlxl927rc3xajk98j5iv6a1zs1g-xzar-server/bin/xzar-server

# ── Postgres ─────────────────────────────────────────────────────────
# Socket-auth connection strings; the role is the one running the service.
MACMGMT_DSN=postgres:///macmgmt?host=/run/postgresql
XZAR_DSN=postgres://reagent@/xzar?host=/run/postgresql

# ── Incus host running the fleet ─────────────────────────────────────
# SSH target (must have the incus CLI) and the HTTPS API endpoint.
INCUS_SSH=root@strontium.y.mkg20001.io
INCUS_URL=https://strontium.y.mkg20001.io:8443
# Incus project the fleet's instances live in.
INCUS_PROJECT=reagent-fleet
# Client certificate the runner authenticates with (trusted on the Incus host).
INCUS_CLIENT_CERT=$FLEET_DIR/runner/incus-client.crt
INCUS_CLIENT_KEY=$FLEET_DIR/runner/incus-client.key
# Networks/subnets of the bridge the instances sit on. Used by the port and
# reachability helpers.
FLEET_SUBNET_V4=10.33.0.0/24
FLEET_SUBNET_V6=2a01:4f8:c012:2caf:3010::/80

# ── Instance debugging ────────────────────────────────────────────────
# Address instances use to reach this host on the bridge (usually the
# bridge gateway). instance-diag.sh reports the server's reachability from
# inside an instance using this.
BRIDGE_GATEWAY_URL=http://10.33.0.1:7378

# ── Daemon binary published into xzar ────────────────────────────────
# Version pinned into the server's daemon_versions table and published as
# daemon/<version>/<system> plus daemon/rolling/<system>.
DAEMON_VERSION=0.1.5
DAEMON_SYSTEM=x86_64-linux
